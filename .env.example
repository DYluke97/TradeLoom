# Optional: override where TradeLoom stores your local notes, Obsidian vault, manuals, and API settings.
# Defaults to <repo>/workspace (already gitignored).
# TRADELOOM_WORKSPACE_DIR=/path/to/your/tradeloom-workspace

# Optional: point directly to an existing folder of raw notes (.md/.txt/.docx/.html/.pdf)
# TRADELOOM_SOURCE_DIR=/path/to/your/trading-reviews

# Optional: pre-configure an OpenAI-compatible LLM provider via env
# (You can also configure this directly in the Settings UI at /settings)
# TRADELOOM_LLM_URL=https://api.deepseek.com/v1/chat/completions
# TRADELOOM_LLM_MODEL=deepseek-chat
# TRADELOOM_LLM_API_KEY=
